{
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "Match": { "Path": "/oauth/{**catchAll}" },
        "ClusterId": "authCluster"
      },
      "lesson": {
        "Match": { "Path": "/lesson/{**catchAll}" },
        "ClusterId": "lessonCluster"
      },
      "share": {
        "Match": { "Path": "/share/{**catchAll}" },
        "ClusterId": "shareCluster"
      },
      "personality": {
        "Match": { "Path": "/personality/{**catchAll}" },
        "ClusterId": "personalityCluster"
      },
      "shop": {
        "Match": { "Path": "/shop/{**catchAll}" },
        "ClusterId": "shopCluster"
      }
    },
    "Clusters": {
      "authCluster": {
        "PrefixTransforms": [ { "Path": "/oauth" } ],
        "Destinations": { "dest1": { "Address": "http://localhost:5000" } }
      },
      "lessonCluster": {
        "PrefixTransforms": [ { "Path": "/lesson" } ],
        "Destinations": { "dest1": { "Address": "http://localhost:3000" } }
      },
      "shareCluster": {
        "PrefixTransforms": [ { "Path": "/share" } ],
        "Destinations": { "dest1": { "Address": "http://localhost:5119" } }
      },
      "personalityCluster": {
        "PrefixTransforms": [ { "Path": "/personality" } ],
        "Destinations": { "dest1": { "Address": "http://localhost:3002" } }
      },
      "shopCluster": {
        "PrefixTransforms": [ { "Path": "/shop" } ],
        "Destinations": { "dest1": { "Address": "http://localhost:5067" } }
      }
    }
  }
}
